# Generate a private secret with: openssl rand -base64 48
# Rotate the formerly published development secret in local/deployed environments.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"
# Set true behind a trusted reverse proxy that overwrites forwarded host headers.
AUTH_TRUST_HOST=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL. Set DATABASE_URL in .env.local, then run pnpm db:migrate.
DATABASE_URL=""
# Isolated billing integration database; use a name beginning with describe_audit.
TEST_DATABASE_URL=""

# Required: explicit model name and private Gemini API key. No demo fallback.
VISION_API_KEY=""
VISION_MODEL=""

# Required for image generation. Keep this key on the server.
SEEAPI_API_KEY=""
# NSFW Filter 2.0 threshold: 0.01-0.99. Special-care blocking is always enabled.
SEEAPI_NSFW_THRESHOLD="0.5"

# Use test or live. Keys, webhook secret and products must belong to that mode.
CREEM_ENVIRONMENT="test"
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
CREEM_PRODUCT_STARTER=""
CREEM_PRODUCT_PRO_MONTH=""
CREEM_PRODUCT_PRO_YEAR=""

# Optional: a client IP header overwritten by your trusted ingress. Never trust caller-supplied forwarding headers.
TRUSTED_CLIENT_IP_HEADER=""
